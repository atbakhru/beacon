# Docker Compose supplies local development values. Never expose demo mode to real data.
DEMO_MODE=true
DATABASE_URL=postgres://beacon:beacon@localhost:5432/beacon?sslmode=disable
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:19092
EMBED_URL=http://localhost:8091
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8088
# For learned semantic embeddings:
# SEMANTIC=true
# MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Authenticated API: DEMO_MODE=false, API_KEYS_JSON={"your-secret-key":"your-org-uuid"}
