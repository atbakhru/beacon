{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beacon event envelope",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "org_id",
    "occurred_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "org_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "alert_id": {
      "type": "string",
      "format": "uuid"
    },
    "incident_id": {
      "type": "string",
      "format": "uuid"
    },
    "cursor": {
      "type": "integer"
    }
  }
}
